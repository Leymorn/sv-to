---
import Layout from '../layouts/Layout.astro';
import Container from '../shared/ui/Container.astro';
import Carousel from '../shared/ui/carousel/Carousel.tsx';
import CompanyProjects from '@/widgets/pages/index/ui/CompanyProjects.tsx';
import CompanyAdvantages from '@/widgets/pages/index/ui/CompanyAdvantages.tsx';
import CategoryRibbon from '@/shared/ui/category-ribbon/CategoryRibbon.tsx';
import Link from '@/shared/ui/Link';
import Clients from '@/widgets/pages/index/ui/Clients.tsx';
import Contacts from '@/widgets/pages/index/ui/Contacts.astro';
import { ROUTES } from '@/shared/router/routes';
import { CATALOG_LINKS_WITH_IMAGES } from '@/shared/model/CatalogLinksWithImages';
import { SERVICES_LIST_WITH_IMAGES } from '@/shared/model/ServicesListWithImages';
import type { SeoMetadata } from '@/shared/model/SeoMetadata';

const seo: SeoMetadata = {
    title: '"СВ" Торговое оборудование',
    description:
        'Производство и продажа торгового оборудования: манекены, витрины, стеллажи, экономпанели, системы труб и стоек. Качественное торговое оборудование для магазинов.',
    image: '/banner_0.png',
    imageAlt: '"СВ" Торговое оборудование',
    keywords:
        'торговое оборудование, манекены, витрины, стеллажи, экономпанели, торговое оборудование для магазинов',
};

const banners = ['/banner_0.png', '/banner_1.png', '/banner_2.png'];
const articles = [
    {
        title: 'Кондитерские магазины — тонкости открытия и оборудования',
        description:
            'Сладости — товар, который актуален в любой время года, он пользуется спросом у взрослых и детей.',
        image: '/articles/konditer.webp',
    },
    {
        title: 'Варианты использования экономпанелей',
        description:
            'Главным достоинством экономпанелей является универсальность их применения.',
        image: '/articles/ekonompaneli.webp',
    },
    {
        title: 'Организация и техническое оснащение аптеки',
        description:
            'Организация и техническое оснащение аптеки — сложная задача, требующая внимательного подхода и учета многих факторов.',
        image: '/articles/apteki.webp',
    },
    {
        title: 'Кондитерские магазины — тонкости открытия и оборудования',
        description:
            'Сладости — товар, который актуален в любой время года, он пользуется спросом у взрослых и детей.',
        image: '/articles/konditer.webp',
    },
];
---

<Layout title='"СВ" Торговое оборудование' seo={seo}>
    <Container class="flex-col">
        <Carousel
            client:load
            carouselClassList="h-[440px]"
            slideWidth="100%"
            images={banners}
            showLink={true}
            options={{ loop: true }}
        />
        <!--<CompanyProjects /> -->
        <CompanyAdvantages />
        <CategoryRibbon
            title="Каталог"
            href={ROUTES.CATALOG.INDEX}
            items={CATALOG_LINKS_WITH_IMAGES.slice(0, 4)}
        />
        <CategoryRibbon
            title="Услуги"
            href={ROUTES.USLUGI.INDEX}
            items={SERVICES_LIST_WITH_IMAGES.slice(0, 4)}
        />
        <div class="w-full flex justify-between pb-5 pt-10">
            <span class="text-lg md:text-2xl font-semibold"
                >Полезные статьи</span
            >
            <Link type="gray" href="/" text="Все статьи" />
        </div>
        <Carousel
            client:only="react"
            carouselClassList="h-[306px]"
            slideWidth="400px"
            articles={articles}
            gap="5"
        />
        <Clients />
        <Contacts />
    </Container>
</Layout>
