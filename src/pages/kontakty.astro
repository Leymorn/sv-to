---
import Layout from '@/layouts/Layout.astro';
import Container from '@/shared/ui/Container.astro';
import {
    ContactPeopleBlock,
    AddressBlock,
    LegalAddressBlock,
    DeliverySection,
    MapBlock,
} from '@/widgets/pages/kontakty';
import Contacts from '@/shared/ui/contacts/Contacts.astro';
import type { SeoMetadata } from '@/shared/model/SeoMetadata';

const seo: SeoMetadata = {
    title: "Контакты мебельного производства СВ - торговое оборудование | СВ - торговое оборудование в Санкт-Петербурге",
    description: "Изготовление торгового оборудования на заказ, торговая и домашняя мебель по размерам заказчика. тел. 300-59-69, svto@mail.ru. Офис и производство в Коломягах.",
    keywords: "Контакты СВ-ТО",
    ogTitle: "Контакты",
    ogDescription: "Тел.:  (812) 300-59-69, (812) 300-10-27, (812) 394-97-83, +7 (901) 315-13-52 Вы можете заказать выезд дизайнера на объект, позвонив по указанным телефонам. Часы работы: Пн→Пт с 9:30 до 18:30, обед на производстве и складе с 13:00 до 14:00 e-mail: svto@mail.ru Социальные сети: Группа ВКонтакте / Инстаграм Адрес: г. Санкт-Петербург, ул. Маршала Новикова, 28 к 4Б. Заезд с [...]",
    image: "/og-images/kontakty.png",
    imageAlt: "Контакты мебельного производства СВ - торговое оборудование | СВ - торговое оборудование в Санкт-Петербурге",
};
---
<Layout seo={seo}>
    <Container class="flex-col gap-12 md:gap-16">
        <h1 class="text-[24px] md:text-[32px] font-semibold">
            Контактная информация
        </h1>
        <div
            class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-[250px_350px_1fr] gap-5"
        >
            <article class="flex flex-col gap-2">
                <h3 class="text-lg md:text-xl font-semibold pb-4 md:pb-8">
                    Контакты
                </h3>
                <Contacts />
            </article>
            <AddressBlock />
            <MapBlock />
            <div class="block sm:hidden">
                <script
                    type="text/javascript"
                    charset="utf-8"
                    async
                    src="https://api-maps.yandex.ru/services/constructor/1.0/js/?um=constructor%3A569c28b10359696529938bb7227574f964969b8fc0a820608b361d1f81e18c24&width=320&height=340&lang=ru_RU&scroll=true"
                ></script>
            </div>
            <LegalAddressBlock />
            <ContactPeopleBlock />
        </div>
        <DeliverySection />
    </Container>
</Layout>
