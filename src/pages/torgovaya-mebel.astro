---
import Layout from '@/layouts/Layout.astro';
import Container from '@/widgets/shared/ui/Container.astro';
import Carousel from '@/widgets/shared/ui/carousel/Carousel.tsx';
import Link from '@/widgets/shared/ui/Link.tsx';
import { ROUTES } from '@/widgets/shared/router/routes';

import {
    CatalogBlock,
    SuitableForBlock,
    StagesBlock,
    AdvantagesBlock,
    RequestBlock,
} from '@/widgets/pages/torgovaya-mebel';

const images = [
    '/banner_0.png',
    '/banner_1.png',
    '/banner_2.png',
    '/banner_0.png',
    '/banner_1.png',
    '/banner_2.png',
];
console.log('StagesBlock');
---

<Layout title="Torgovaya Mebel">
    <Container class="flex-col">
        <h1 class="text-lg md:text-2xl font-semibold md:mb-6 mb-3 text-center">
            Торговая мебель
        </h1>
        <p class="text-center text-base md:text-xl md:mb-10 mb-5">
            Производство, доставка и монтаж под ключ. Работаем по всей России.
        </p>
        <Carousel
            client:only="react"
            slideHeight="440px"
            slideWidth="70%"
            images={images}
            loop={true}
            gap="5"
        />
        <div class="flex justify-center gap-5 md:my-10 my-5">
            <Link
                type="default"
                href={ROUTES.CATALOG_I_CENY}
                classList="md:text-lg text-base"
                text="Перейти к каталогу"
            />
            <!-- TODO: add link -->
            <Link
                type="outline"
                href={'/'}
                classList="md:text-lg text-base"
                text="Рассчитать стоимость"
            />
        </div>
        <CatalogBlock />
        <SuitableForBlock />
        <StagesBlock />
        <AdvantagesBlock />
        <RequestBlock client:load />
    </Container></Layout
>
