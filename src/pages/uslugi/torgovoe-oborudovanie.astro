---
import Layout from '@/layouts/Layout.astro';
import Container from '@/shared/ui/Container.astro';
import Link from '@/shared/ui/Link.tsx';
import { ROUTES } from '@/shared/router/routes';
import Image from '@/shared/ui/Image.tsx';
import type { SeoMetadata } from '@/shared/model/SeoMetadata';
import {
    SuitableForBlock,
    StagesBlock,
    AdvantagesBlock,
    RequestBlock,
} from '@/widgets/pages/torgovoe-oborudovanie';

const seo: SeoMetadata = {
    title: "Торговое оборудование для гуру оптики | СВ - торговое оборудование в Санкт-Петербурге",
    description: "Проект торгового оборудования для сети салонов оптики: стеновые панели с держателями для оправ, накопители и навигация, островная кассовая стойка и полки на экономпанелях для аксессуаров для оптики. Также оборудован кабинет врача-офтальмолога. Монтаж производился в г, Калининград.",
    keywords: "Кассовая стойка / ресепшн,Экономпанели,Салоны оптики",
    ogTitle: "Торговое оборудование для гуру оптики",
    ogDescription: "Наш постоянный клиент, ширящий сеть салонов оптики в Северо-Западном регионе. Салон в Калининграде: сформированная концепция торгового оборудования для оптики и аксессуаров.",
    image: "/og-images/uslugi-torgovoe-oborudovanie.png",
    imageAlt: "Торговое оборудование для гуру оптики | СВ - торговое оборудование в Санкт-Петербурге",
};
---
<Layout seo={seo}>
    <Container class="flex-col">
        <div
            class="grid grid-cols-1 md:grid-cols-2 justify-center gap-5 md:my-10 my-5"
        >
            <div class="flex flex-col gap-5 text-lg md:text-xl font-medium">
                <h1 class="text-lg md:text-2xl font-semibold">
                    Торговое оборудование
                </h1>
                Мы берём на себя весь процесс: от производства до доставки и монтажа
                под ключ. Работаем по всей России, чтобы ваши проекты реализовывались
                удобно и без лишних хлопот.
                <div class="flex gap-5 mt-auto">
                    <Link
                        type="default"
                        href={ROUTES.CATALOG.INDEX}
                        classList="md:text-lg text-base"
                        text="Перейти к каталогу"
                    />
                    <Link
                        type="outline"
                        href={ROUTES.KONTAKTY}
                        classList="md:text-lg text-base"
                        text="Рассчитать стоимость"
                    />
                </div>
            </div>

            <Image
                src="/torgovoe-oborudovanie/torgovoe-oborudovanie.png"
                alt="Торговое оборудование"
                classList="w-full"
            />
        </div>
        <SuitableForBlock />
        <StagesBlock />
        <AdvantagesBlock />
        <!-- <RequestBlock client:load /> -->
    </Container></Layout
>
