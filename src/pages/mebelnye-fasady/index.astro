---
import Layout from '@/layouts/Layout.astro';
import Container from '@/shared/ui/Container.astro';
import {
    AdditionalServicesSection,
    FacadeTypesSection,
    FasadiPricesSection,
    FilesLinks,
    MebelnyeFasadySubpagesList,
    PosibleFasades,
} from '@/widgets/pages/mebelnye-fasady';
---

<Layout title="Фасады мебельные">
    <Container class="flex-col">
        <h1 class="text-xl md:text-2xl font-semibold mb-4 md:mb-8">
            Мебельные фасады
        </h1>

        <span class="font-montserrat mb-8">
            Мы осуществляем производство мебельных фасадов для кухни, домашней
            мебели, торгового оборудования и прочего.</span
        >
        <MebelnyeFasadySubpagesList />
        <PosibleFasades />
        <FasadiPricesSection />
        <AdditionalServicesSection />
        <FilesLinks />
        <FacadeTypesSection />
    </Container>
</Layout>
