---
import Layout from '@/layouts/Layout.astro';
import Container from '@/shared/ui/Container.astro';
import { PvhFilmsBlock } from '@/widgets/pages/mebelnye-fasady';
import type { SeoMetadata } from '@/shared/model/SeoMetadata';

const seo: SeoMetadata = {
    title: "Заказать мебельные фасады в плёнке ПВХ - каталог плёнок | СВ - торговое оборудование в Санкт-Петербурге",
    description: "Изготовление мебельных фасадов из ПВХ-плёнки на заказ. Выберете ПВХ-плёнку в каталоге плёнок на сайте производителя мебельных фасадов в Санкт-Петербурге.",
    ogTitle: "Каталог плёнок ПВХ",
    ogDescription: "Мебельная плёнка ПВХ используется в качестве декоративного облицовочного материала для фасадов и других изделий из МДФ. Плёнка наносится в строгих производственных условиях, с использованием технологии мембранно-вакуумного прессования на специальном высокотехнологичном оборудовании. Благодаря этому она идеально повторяет форму и текстуру МДФ-заготовки фасада. Изделия, облицованные плёнками ПВХ, имеют долгий срок службы, обладают высокой прочностью, износоустойчивостью, влагостойкостью, стойкостью [...]",
    image: "/og-images/mebelnye-fasady-plenki-pvh.png",
    imageAlt: "Заказать мебельные фасады в плёнке ПВХ - каталог плёнок | СВ - торговое оборудование в Санкт-Петербурге",
};
---
<Layout seo={seo}>
    <Container class="flex-col">
        <h1 class="text-xl md:text-2xl font-semibold md:mb-8 mb-4">
            Каталог пленок ПВХ
        </h1>

        <PvhFilmsBlock client:load />
    </Container>
</Layout>
