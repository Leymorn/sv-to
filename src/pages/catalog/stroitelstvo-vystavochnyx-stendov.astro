---
import Layout from '@/layouts/Layout.astro';
import Container from '@/shared/ui/Container.astro';
import Image from '@/shared/ui/Image';
import Link from '@/shared/ui/Link';
import { ROUTES } from '@/shared/router/routes';
import { Icon } from 'astro-icon/components';
import type { SeoMetadata } from '@/shared/model/SeoMetadata';

const REASONS = [
    'Наглядно представить продукт или услугу',
    'Привлечь внимание и выделиться среди конкурентов',
    'Наладить прямой контакт с клиентами и партнёрами',
    'Усилить имидж бренда на профильных мероприятиях',
];

const COMPONENTS = [
    'Разработка дизайн-проекта с учётом задач и бюджета',
    'Проектирование конструкции',
    'Собственное производство без посредников',
    'Изготовление, доставка, монтаж и демонтаж',
];

const seo: SeoMetadata = {
    title: "Проектирование и строительство выставочных стендов | СВ - торговое оборудование в Санкт-Петербурге",
    description: "Дизайн, проектирование и строительство выставочных, рекламных стендов. Застройка и подготовка стендов к выставкам, форумам и другим мероприятиям под ключ.",
    ogTitle: "Строительство выставочных стендов",
    ogDescription: "Разработка дизайна, проектирование и строительство индивидуальных выставочных стендов. В настоящее время, участие компаний любого масштаба в специализированных выставках предоставляет уникальную возможность по расширению своей деятельности и позволяет вести прямой и открытый диалог с заказчиками. Это уникальный способ презентовать, и наглядно продемонстрировать свою продукцию, услугу или информацию, непосредственно руководителям и специалистам предприятий, отвечающим за поиск новых [...]",
    image: "/og-images/catalog-stroitelstvo-vystavochnyx-stendov.png",
    imageAlt: "Проектирование и строительство выставочных стендов | СВ - торговое оборудование в Санкт-Петербурге",
};
---
<Layout seo={seo}>
    <Container class="flex-col">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10 md:mb-20">
            <div class="text-lg md:text-xl font-medium flex flex-col gap-5">
                <h1 class="text-xl md:text-2xl font-semibold">
                    Cтроительство выставочных стендов
                </h1>
                Дизайн, проектирование и строительство индивидуальных выставочных
                стендов в Санкт-Петербурге и по России. Берём на себя весь процесс
                – от идеи до монтажа на площадке.
                <Link
                    type="outline"
                    href={ROUTES.KONTAKTY}
                    classList="md:text-lg text-base mt-auto w-fit"
                    text="Рассчитать стоимость"
                />
            </div>
            <Image
                src="/catalog/stroitelstvo-vystavochnyx-stendov.png"
                alt="Перегородки"
                classList="w-full h-full object-cover"
            />
        </div>
        <p class="text-lg md:text-xl font-medium text-center mb-4 md:mb-8">
            Зачем нужны выставочные стенды
        </p>
        <div
            class="grid grid-cols-1 md:grid-cols-2 gap-x-20 gap-y-5 max-w-[1000px] self-center mb-10 md:mb-20"
        >
            {
                REASONS.map((reason) => (
                    <div class="flex gap-5 max-w-[500px]">
                        <Icon
                            name="check"
                            class="text-main-color min-w-[54px]"
                            size="36"
                        />
                        {reason}
                    </div>
                ))
            }
        </div>
        <p class="text-lg md:text-xl font-medium text-center mb-4 md:mb-8">
            Что входит в строительство стенда
        </p>
        <div class="grid-cols-2-xs-3-lg-4 gap-2 mb-4 md:mb-8">
            {
                COMPONENTS.map((variant) => (
                    <span class="flex items-center rounded-[20px] border border-main-color p-4 text-sm md:text-base">
                        {variant}
                    </span>
                ))
            }
        </div>
        <p class="text-sm md:text-base mb-10 md:mb-20">
            Дизайн-проект разрабатывается под фирменный стиль компании и формат
            выставки. Собственное производство площадью более 1000 м² позволяет
            изготавливать стенды в сжатые сроки и контролировать качество на
            всех этапах.
        </p>
        <p class="text-lg md:text-xl font-medium mb-2 md:mb-4">
            Для строительства выставочных стендов используются:
        </p>
        <ul
            class="text-sm md:text-base self-start list-disc list-inside mb-2 md:mb-4"
        >
            <li>сертифицированный алюминиевый профиль</li>
            <li>ДСП, МДФ, ПВХ, оргстекло, стекло</li>
            <li>различные конфигурации и соединительные элементы</li>
            <li>интерьерная печать на баннере, плёнке или бумаге</li>
            <li>декоративная и акцентная подсветка</li>
        </ul>
        <p class="text-sm md:text-base mb-4 md:mb-8">
            Это позволяет создавать стенды любой сложности и дизайна.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Image
                src="/catalog/vystavochniy-stend.png"
                alt="Перегородки"
                classList="w-full h-full object-cover"
            />
            <span
                class="text-sm md:text-md flex items-center border border-main-color p-8 text-sm md:text-base"
            >
                Монтаж и демонтаж стендов выполняется нашей командой
                специалистов строго в сроки, установленные организаторами
                выставки. Работаем аккуратно, быстро и с учётом всех технических
                требований площадки.</span
            >
        </div>
    </Container>
</Layout>
