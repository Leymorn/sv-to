---
import Layout from '@/layouts/Layout.astro';
import Container from '@/shared/ui/Container.astro';
import { PodstavkiDlyaTelefonovGrid } from '@/widgets/pages/orgsteklo';
import type { SeoMetadata } from '@/shared/model/SeoMetadata';

const seo: SeoMetadata = {
    title: "Проекты в категории Подставки для телефонов | СВ - торговое оборудование в Санкт-Петербурге",
    ogTitle: "Категория: Подставки для телефонов",
    ogDescription: "Производство и продажа торгового оборудования для магазинов в Санкт-Петербурге, выгодные предложения для желающих купить экономпанели, вешала, стеллажи, манекены, мебельные фасады.",
    image: "/og-images/catalog-orgsteklo-podstavki-dlya-telefonov.png",
    imageAlt: "Проекты в категории Подставки для телефонов | СВ - торговое оборудование в Санкт-Петербурге",
};
---
<Layout seo={seo}>
    <Container class="flex-col">
        <h1 class="text-xl md:text-2xl font-semibold md:mb-8 mb-4 text-center">
            Подставки для телефонов
        </h1>
        <PodstavkiDlyaTelefonovGrid client:load />
    </Container>
</Layout>

