---
import Layout from '@/layouts/Layout.astro';
import Container from '@/shared/ui/Container.astro';
import { ProductCard } from '@/entities/product';
import { BANKETKI } from '@/widgets/pages/banketki';
---

<Layout title="Банкетки">
    <Container class="flex-col">
        <h1 class="text-xl md:text-2xl font-semibold md:mb-6 mb-3 text-center">
            Банкетки
        </h1>
        <div class="grid-cols-2-xs-3-lg-4 gap-5 md:mb-14 mb-7">
            {
                BANKETKI.map((product) => (
                    <ProductCard
                        key={`${product.title}-${product.description}`}
                        {...product}
                    />
                ))
            }
        </div>
    </Container>
</Layout>
