---
import Layout from '@/layouts/Layout.astro';
import Container from '@/shared/ui/Container.astro';
import { CatalogList } from '@/widgets/pages/catalog';
import { ROUTES } from '@/shared/router/routes';
import Link from '@/shared/ui/Link.tsx';
---

<Layout title="Catalog and Prices">
    <Container class="flex-col">
        <h1 class="pb-8 text-[24px] font-semibold">Каталоги и цены</h1>
        <div class="flex flex-col md:flex-row gap-5 pb-12">
            <span>
                Основное направление деятельности нашей компании —
                <Link
                    href={ROUTES.PROIZVODSTVO}
                    type="underline"
                    text="производство торгового оборудования (мебели)"
                />

                на заказ. Также мы занимаемся продажей разных торговых систем
                <br /> и элементов оборудования для магазинов.
            </span>
            <span
                class="border border-main-color rounded-[20px] p-5 lg:px-13 lg:py-7 italic"
            >
                В нашей компании действуют скидки для дилеров на мелкий и
                крупный опт</span
            >
        </div>
        <CatalogList />
    </Container>
</Layout>
