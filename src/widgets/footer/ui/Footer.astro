---
import Image from '@/shared/ui/Image';
import Container from '@/shared/ui/Container.astro';
import FooterNavigation from './FooterNavigation';
import Contacts from '@/shared/ui/contacts/Contacts.astro';
import GoogleMap from './GoogleMap.astro';
---

<footer
    class="w-full bg-gray-color-2 text-white pt-5 pb-20 font-roboto font-light text-sm"
>
    <Container class="grid-cols-2-xs-3-lg-4 gap-5 mx-auto">
        <a class="w-full sm:w-auto" href="/">
            <Image src="/logo.svg" classList="w-[87px]" />
        </a>
        <div class="flex flex-col gap-3">
            <Contacts />
        </div>

        <FooterNavigation />
        <GoogleMap />
    </Container>
</footer>
